@import "tailwindcss";

body {
  background-image: url("./images/catbg2.gif");
  background-repeat: no-repeat;
  background-attachment: fixed;
  background-size: cover;
  background-position: center;
  /* background-color: #BDCCFF; */
  margin: 0;
  /* height: 100vh; */
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: 'Georgia', serif;
}

#logoutButton {
  width: 80%;
  max-width: 150px;
  padding: 12px;
  font-size: 18px;
  border-radius: 3%;
  background-color: #202C37;
  color: white;
  border: none;
  cursor: pointer;
  margin-left: 20px;
}

#loggedInDiv {
  color: #000000;
  font-size: 20px;
  margin-bottom: 50px;
}

#loginField {
  font-size: 16px;
}

#title {
  font-size: 69px;
  color: #000000;
  align-items: left;
}

#login {
  font-size: 50px;
  color: #000000;
  margin-bottom: 40px;
  font-weight: bolder;
}

#logo {
  width: 160px;
  padding: 0px;
  margin: 0px;
  margin-top: 10px;
}

#loginDiv, #userinfo {
  margin: auto;
  background: #ffffff;
  color: #000000;
  box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.5);
  border-radius: 3%;
  padding: 12px;
  width: 600px;
  height: 666x;
  max-width: 600px;
  box-sizing: border-box;
  text-align: left;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  opacity: 0.9;
  border-top-color:#c1f3ff;
  border-top-width: 0;
}

td,th {
  min-width: 200px;
  padding: 10px;
}

input[type="text"],
input[type="password"] {
  width: 80%;
  padding: 12px;
  border-radius: 3%;
  border: 2px solid #000000;
  font-size: 16px;
  background-color: #C1C8BE;
  color: rgb(0, 0, 0);
  text-align: left;
  box-sizing: border-box;
}


.buttons {
  width: 80%;
  padding: 12px;
  font-size: 18px;
  border-radius: 3%;
  background-color: #8FAEAC;
  color: white;
  border: none;
  cursor: pointer;
}

.buttons:hover {
  background-color: #b1c9c8;
  opacity: 0.8;
}

#loginResult, #loginResult2{
  display: inline-block;
  font-size: 0.8em;
  width: 90%;
  text-align: center;
  margin-left: 5%;
  margin-bottom: 2%;
  color: #95060a;
}

#signupDiv {
  margin: auto;
  background: #ffffff;
  box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.5);
  border-radius: 3%;
  padding: 12px;
  width: 80%;
  height: 555x;
  max-width: 400px;
  box-sizing: border-box;
  text-align: left;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  opacity: 0.9;
}

#signup {
  font-size: 50px;
  color: #000000;
  margin-bottom: 30px;
  font-weight: bolder;
}

#bottomtext {
  font-size: 15px;
  color: #000000;
  margin-top: 10px;
  text-align: left;
}

#root {
  max-width: 1280px;
  margin: 0 auto;
  padding: 2rem;
  text-align: center;
}

.logo {
  height: 6em;
  padding: 1.5em;
  will-change: filter;
  transition: filter 300ms;
}
.logo:hover {
  filter: drop-shadow(0 0 2em #646cffaa);
}
.logo.react:hover {
  filter: drop-shadow(0 0 2em #61dafbaa);
}



@keyframes logo-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: no-preference) {
  a:nth-of-type(2) .logo {
    animation: logo-spin infinite 20s linear;
  }
}

.card {
  padding: 2em;
}

.read-the-docs {
  color: #888;
}
